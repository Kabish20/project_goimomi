[Unit]
Description=Recover pending Global Horizons Excel emails
After=network.target redis-server.service postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/goimomi/goimomibackend
ExecStart=/var/www/goimomi-venv/bin/python manage.py retry_profile_export_emails --settings=backend.server_settings
NoNewPrivileges=true
PrivateTmp=true
